source="remcom_windows-sysmon-fixed.txt"
| rex field=_raw "<Data Name='UtcTime'>(?<UtcTime>[^<]+)</Data>"
| rex field=_raw "<Data Name='CommandLine'>(?<CommandLine>[^<]+)</Data>"
| rex field=_raw "<Data Name='User'>(?<User>[^<]+)</Data>"
| rex field=CommandLine "\\\\(?<RemoteTarget>localhost|127\.0\.0\.1)"
| eval CredentialFlag=case(
    match(CommandLine,"(?i)/user:"),"/user:",
    match(CommandLine,"(?i)/usr:"),"/usr:",
    match(CommandLine,"(?i)\s-u\s"),"-u",
    true(),"None"
)
| where isnotnull(RemoteTarget)
| table UtcTime User RemoteTarget CredentialFlag CommandLine
